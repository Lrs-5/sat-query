# When true, the app uses the built-in mock analysis service instead of
# calling the real M4 FastAPI backend. Keep this as "true" until the
# backend is ready to receive requests.
VITE_USE_MOCK=true

# Base URL of the M4 FastAPI backend. Only used when VITE_USE_MOCK=false.
VITE_API_BASE_URL=http://localhost:8000
